+import ExpoModulesCore
+import UIKit
+
+private enum HiddenCanvasLookupError: Error {
+  case unsupportedOSVersion
+  case containerNotFound(String)
+}
+
+private func hiddenCanvasClassName() throws -> String {
+  if #available(iOS 15, *) {
+    return "_UITextLayoutCanvasView"
+  }
+  if #available(iOS 13, *) {
+    return "_UITextFieldCanvasView"
+  }
+  if #available(iOS 12, *) {
+    return "_UITextFieldContentView"
+  }
+  throw HiddenCanvasLookupError.unsupportedOSVersion
+}
+
+private func findHiddenCanvas(in view: UIView) throws -> UIView {
+  let className = try hiddenCanvasClassName()
+  guard let container = view.subviews.first(where: { type(of: $0).description() == className }) else {
+    throw HiddenCanvasLookupError.containerNotFound(className)
+  }
+  return container
+}
+
+// Wraps its React children inside the protected rendering surface a secure
+// UITextField uses for its text (the same surface iOS uses to hide passcode
+// digits). Content inside is excluded from screenshots, screen recording, and
+// AirPlay/QuickTime mirroring, while remaining a normal interactive subview.
+//
+// The text field itself is never added to the view hierarchy — its private
+// canvas subview is pulled out and adopted directly, and isSecureTextEntry is
+// flipped on asynchronously after adoption (setting it during init doesn't
+// take effect). This relies on a private UIKit view class name, which is not
+// a stable API; onStatus reports usingSecureCanvas=false if a future iOS
+// release changes it, so callers can fall back or alert rather than silently
+// exposing content.
+class SecureContentView: ExpoView {
+  private let secureField = UITextField()
+  private var hiddenCanvas: UIView?
+  let onStatus = EventDispatcher()
+
+  required init(appContext: AppContext? = nil) {
+    super.init(appContext: appContext)
+
+    secureField.backgroundColor = .clear
+    secureField.isUserInteractionEnabled = false
+
+    if let canvas = try? findHiddenCanvas(in: secureField) {
+      hiddenCanvas = canvas
+      canvas.isUserInteractionEnabled = true
+      // React children mount into this canvas during the current transaction,
+      // but isSecureTextEntry only takes effect on the next main-queue hop
+      // (setting it during init does not stick). Without this the canvas would
+      // paint at least one unprotected frame, which a screen recording that is
+      // already running when the SRP is revealed would capture. Stay hidden
+      // until the field is actually secure.
+      canvas.isHidden = true
+      addSubview(canvas)
+    }
+
+    // Both outcomes are reported from this one deferred hop. onStatus is a
+    // React prop, so emitting during init would fire before the listener is
+    // attached and the event would be dropped — which would silently lose the
+    // usingSecureCanvas=false signal this exists to raise.
+    DispatchQueue.main.async { [weak self] in
+      guard let self else {
+        return
+      }
+      let usingSecureCanvas = self.hiddenCanvas != nil
+      if usingSecureCanvas {
+        self.secureField.isSecureTextEntry = true
+        self.hiddenCanvas?.isHidden = false
+      }
+      self.onStatus(["usingSecureCanvas": usingSecureCanvas])
+    }
+  }
+
+  override func layoutSubviews() {
+    super.layoutSubviews()
+    hiddenCanvas?.frame = bounds
+  }
+
+  // On the new architecture (Fabric), children arrive through
+  // mountChildComponentView — didUpdateReactSubviews never runs — and the
+  // default implementation inserts them directly into the component view,
+  // bypassing the secure canvas. Route them into the canvas instead.
+  override func mountChildComponentView(_ childComponentView: UIView, index: Int) {
+    guard let canvas = hiddenCanvas else {
+      super.mountChildComponentView(childComponentView, index: index)
+      return
+    }
+    canvas.insertSubview(childComponentView, at: min(index, canvas.subviews.count))
+  }
+
+  override func unmountChildComponentView(_ childComponentView: UIView, index: Int) {
+    // Mirror mountChildComponentView: children that went through super must be
+    // unmounted through super too, so React Native's own child bookkeeping stays
+    // consistent. Only canvas-adopted children are detached directly.
+    guard hiddenCanvas != nil else {
+      super.unmountChildComponentView(childComponentView, index: index)
+      return
+    }
+    childComponentView.removeFromSuperview()
+  }
+
+  // Old architecture (Paper) fallback.
+  override func didUpdateReactSubviews() {
+    let target = hiddenCanvas ?? self
+    reactSubviews()?.forEach { target.addSubview($0) }
+  }
+}
