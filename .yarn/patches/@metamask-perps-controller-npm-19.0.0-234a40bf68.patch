+        baseAmount: size.toFixed(0),
+        price: price.toFixed(0),
+        isAsk: intent.isBuy ? 0 : 1,
+        orderType: 6,
+        timeInForce: LIGHTER_TIME_IN_FORCE_GOOD_TILL_TIME,
+        reduceOnly: intent.reduceOnly ? 1 : 0,
