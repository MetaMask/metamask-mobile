+    [LIGHTER_ORDER_TYPE_STOP_LOSS_LIMIT]: 'stop-loss-limit',
+    [LIGHTER_ORDER_TYPE_TAKE_PROFIT]: 'take-profit',
+    [LIGHTER_ORDER_TYPE_TAKE_PROFIT_LIMIT]: 'take-profit-limit',
+};
