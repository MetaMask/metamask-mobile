+import { LIGHTER_ORDER_TYPE_LIMIT, LIGHTER_ORDER_TYPE_MARKET, LIGHTER_ORDER_TYPE_STOP_LOSS, LIGHTER_ORDER_TYPE_STOP_LOSS_LIMIT, LIGHTER_ORDER_TYPE_TAKE_PROFIT, LIGHTER_ORDER_TYPE_TAKE_PROFIT_LIMIT, LIGHTER_TIME_IN_FORCE_IMMEDIATE_OR_CANCEL, LIGHTER_TIME_IN_FORCE_GOOD_TILL_TIME, LIGHTER_ORDER_EXPIRY_NONE, LIGHTER_MAX_WIRE_PRICE, LIGHTER_MIN_TRADING_API_KEY_INDEX, LIGHTER_MAX_TRADING_API_KEY_INDEX, } from '../constants/lighterConfig.js';
