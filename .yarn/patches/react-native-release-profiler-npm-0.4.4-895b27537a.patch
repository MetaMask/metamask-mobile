+      HermesSamplingProfiler.disable()
+
+      stage.set("dump")
+      Log.i(TAG, "Hermes profile export stage=dump path=${cacheFile.getPath()}")
+      HermesSamplingProfiler.dumpSampledTraceToFile(cacheFile.getPath())
+
+      stage.set("copy")
+      Log.i(TAG, "Hermes profile export stage=copy")
+      val externalDirectory =
+        reactContext.getExternalFilesDir(Environment.DIRECTORY_DOCUMENTS)
+          ?: throw IllegalStateException("External app storage unavailable")
+      val outputFile = File(externalDirectory, cacheFile.name)
+      cacheFile.inputStream().use { input ->
+        outputFile.outputStream().use { output ->
+          input.copyTo(output)
+        }
+      }
+      if (!outputFile.exists() || outputFile.length() == 0L) {
+        throw IllegalStateException("Profile copy was empty")
+      }
+
+      stage.set("complete")
+      Log.i(TAG, "Hermes profile export complete path=${outputFile.getPath()}")
+      if (settled.compareAndSet(false, true)) {
+        promise.resolve(outputFile.getPath())
+      }
+    } catch (error: Throwable) {
+      if (settled.compareAndSet(false, true)) {
+        Log.e(TAG, "Hermes profile export failed at stage=${stage.get()}", error)
+        promise.reject(
+          "PROFILE_EXPORT_FAILED",
+          "Hermes profile export failed at stage=${stage.get()}: ${error.message}",
+        )
+      }
+    } finally {
+      timeout.cancel(false)
+      timeoutExecutor.shutdown()
+    }
+  }
