+  @ReactMethod
+  fun stopProfilingToExternalFiles(promise: Promise) {
+    val cacheFile = File.createTempFile(
+      "sampling-profiler-trace", ".cpuprofile", reactContext.getCacheDir())
+    val externalDirectory =
+      reactContext.getExternalFilesDir(Environment.DIRECTORY_DOCUMENTS)
+        ?: reactContext.getCacheDir()
+    val outputFile = File.createTempFile(
+      "sampling-profiler-trace", ".cpuprofile", externalDirectory)
+    val cachePath = cacheFile.getPath()
+    HermesSamplingProfiler.dumpSampledTraceToFile(cachePath)
+    HermesSamplingProfiler.disable()
+    cacheFile.inputStream().use { input ->
+      outputFile.outputStream().use { output ->
+        input.copyTo(output)
+      }
+    }
+    if (!outputFile.exists() || outputFile.length() == 0L) {
+      promise.reject("PROFILE_EXPORT_FAILED", "Profile copy was empty")
+      return
+    }
+    promise.resolve(outputFile.getPath())
+  }
+
   companion object {
     const val NAME = "ReleaseProfiler"
   }
