# Do not source nvm.sh: nvm returns 3 under set -e and aborts Xcode phases.
_mm_ios_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_mm_nvmrc="${_mm_ios_dir}/../.nvmrc"
_mm_node=""
if [ -f "$_mm_nvmrc" ]; then
  _mm_ver="$(tr -d '[:space:]' < "$_mm_nvmrc")"
  _mm_node="${HOME}/.nvm/versions/node/v${_mm_ver#v}/bin/node"
fi
if [ -x "$_mm_node" ]; then
  export NODE_BINARY="$_mm_node"
elif command -v node >/dev/null 2>&1; then
  export NODE_BINARY="$(command -v node)"
elif [ -x /opt/homebrew/bin/node ]; then
  export NODE_BINARY=/opt/homebrew/bin/node
elif [ -x /usr/local/bin/node ]; then
  export NODE_BINARY=/usr/local/bin/node
fi
unset _mm_ios_dir _mm_nvmrc _mm_node _mm_ver
