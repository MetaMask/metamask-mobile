def common_target_logic
  podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

  use_expo_modules!
	# config = use_native_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  # Pods for MetaMask
  pod 'ReactNativePayments', :path => '../node_modules/@metamask/react-native-payments/lib/ios/'

  # Pods for Push Notifications
  pod 'FirebaseCore', :modular_headers => true
  pod 'GoogleUtilities/NSData+zlib', :modular_headers => true

   # Comment the next line if you don't want to use dynamic frameworks
  # use_frameworks!
  pod 'GzipSwift'

  # Pod for fixing react-native-quick-crypto issue: https://github.com/margelo/react-native-quick-crypto/issues/244
  pod 'OpenSSL-Universal', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
    :hermes_enabled => true
  )

  # NitroFetch (Swift) requires React-RCTNetwork to export module maps
  pod 'React-RCTNetwork', :path => "#{config[:reactNativePath]}/Libraries/Network", :modular_headers => true
end

target 'MetaMask' do
  common_target_logic
end

target 'MetaMask-Flask' do
	common_target_logic
end

# ExpoWidgetsTarget: the WidgetKit + Live Activities app extension that hosts
# all `expo-widgets` widgets (see app/core/Widgets/ and docs/widgets/README.md).
#
# This mirrors what the `expo-widgets` config plugin's `withPodsLinking`
# generates. It is applied by hand — rather than by `expo prebuild` — because
# this is a bare workflow project with a checked-in ios/ directory that the
# plugin never runs against. Keep this block in sync if `expo-widgets` is
# upgraded and its Podfile template changes
# (node_modules/expo-widgets/plugin/src/withPodsLinking.ts).
target 'ExpoWidgetsTarget' do
  # Only autolinks `expo`, `expo-widgets`, and `@expo/ui` — the extension does
  # not need the full set of Expo modules the main app uses.
  use_expo_modules_widgets!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    widgets_config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    widgets_config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  widgets_config = use_expo_native_module!(widgets_config_command)

  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => widgets_config[:reactNativePath],
    :hermes_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )
end

if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
  config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
else
  config_command = [
    'node',
    '--no-warnings',
    '--eval',
    'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
    'react-native-config',
    '--json',
    '--platform',
    'ios'
  ]
end

config = use_native_modules!(config_command)

# KNOWN LIMITATION / WORKAROUND — see docs/widgets/README.md
# ("Known limitation: the widget extension links every autolinked pod") and
# https://github.com/expo/expo/issues/44695.
#
# React Native's New Architecture codegen (ReactCodegen / ReactAppDependencyProvider)
# is generated from a single, Podfile-wide scan of package.json — it is NOT
# scoped per `target` block. Because `ExpoWidgetsTarget` also calls
# `use_react_native!` (required so ExpoModulesCore/ExpoUI can link React's
# shared C++ infra), its `ReactCodegen` pod ends up compiling a TurboModule
# spec for *every* autolinked native module in the whole app (Braze, Sentry,
# Firebase, Branch, ...) — even though the widget's JS layer never calls any
# of them (see createMetaMaskWidget.ios.ts for why it structurally can't).
# Some of those SDKs call APIs that are unavailable in app extensions (e.g.
# `UIApplication.shared`), which then fail to *compile* once CocoaPods marks
# their pod target `APPLICATION_EXTENSION_API_ONLY = YES` (required because
# `ExpoWidgetsTarget`, an app extension, also depends on them transitively).
#
# This function silences that compile-time check for every pod the widget
# extension pulls in (other than the Expo/React-* pods `expo_widgets_post_install`
# already un-flags). It does NOT make the underlying SDK code
# extension-safe — it only lets it compile. This is safe at *runtime* (that
# code is never reached from the widget), but Apple's App Store binary
# validation may still flag extension-unavailable symbols in the shipped
# extension binary. Revisit before shipping — see docs/widgets/README.md.
def expo_widgets_disable_extension_api_only_workaround!(installer)
  widgets_aggregate = installer.aggregate_targets.find { |t| t.name.include?('ExpoWidgetsTarget') }
  return unless widgets_aggregate

  pod_names_used_by_widgets = widgets_aggregate.pod_targets.map(&:pod_name)

  installer.pods_project.targets.each do |target|
    next unless pod_names_used_by_widgets.include?(target.name)
    next if target.name == 'ExpoModulesCore' || target.name == 'ExpoUI' || target.name.start_with?('React-')

    target.build_configurations.each do |config|
      config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'NO'
    end
  end
end

post_install do |installer|
  # ExpoModulesCore/ExpoUI/React-* pods are compiled with
  # APPLICATION_EXTENSION_API_ONLY by default, but the widget extension needs
  # to link against them, which requires this to be disabled for those pods
  # specifically (the ExpoWidgetsTarget itself stays APPLICATION_EXTENSION_API_ONLY=YES).
  expo_widgets_post_install(installer)
  expo_widgets_disable_extension_api_only_workaround!(installer)

  react_native_post_install(
    installer,
    config[:reactNativePath],
    :mac_catalyst_enabled => false,
    :ccache_enabled => podfile_properties['apple.ccacheEnabled'] == 'true',
  )

  # Modify RCT-Folly Portability.h to disable coroutines
  Dir.glob(installer.sandbox.root + "RCT-Folly/folly/Portability.h") do |file|
    begin
      # First try to make the file writable
      system "chmod +w #{file}"

      contents = File.read(file)
      modified_contents = contents.gsub(/#define FOLLY_HAS_COROUTINES 1/, '#define FOLLY_HAS_COROUTINES 0')

      # Try writing with elevated privileges if needed
      if !File.writable?(file)
        system "sudo chmod +w #{file}"
      end

      File.write(file, modified_contents)

      # Optionally restore original permissions
      system "chmod -w #{file}"
    rescue => e
      Pod::UI.warn "Failed to modify Portability.h: #{e.message}"
    end
  end

  # Fix fmt compilation error with Xcode 26 / Clang 21 consteval strictness
  # Directly disable FMT_USE_CONSTEVAL rather than patching the detection logic.
  # Uses regex to handle indented preprocessor directives (e.g. "#  define").
  Dir.glob(installer.sandbox.root + "fmt/include/fmt/base.h") do |file|
    begin
      system "chmod +w #{file}"
      contents = File.read(file)
      modified = contents.gsub(/#\s*define FMT_USE_CONSTEVAL 1/, '#define FMT_USE_CONSTEVAL 0')
      if !File.writable?(file)
        system "sudo chmod +w #{file}"
      end
      File.write(file, modified)
      system "chmod -w #{file}"
    rescue => e
      Pod::UI.warn "Failed to modify fmt base.h: #{e.message}"
    end
  end

  # This is necessary for Xcode 14, because it signs resource bundles by default
  # when building for devices.
  installer.target_installation_results.pod_target_installation_results
    .each do |pod_name, target_installation_result|
    target_installation_result.resource_bundle_targets.each do |resource_bundle_target|
      resource_bundle_target.build_configurations.each do |config|
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      end
    end
  end
end
