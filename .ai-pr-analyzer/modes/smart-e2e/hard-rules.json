  {
    "name": "test-shared-infra-impact",
    "description": "Changes to flows, page-objects, selectors, or locators — find impacted smoke specs and run their tags",
    "trigger": {
      "type": "extractTagsFromImportGraph",
      "sourcePrefixes": [
        "tests/flows/",
        "tests/page-objects/",
        "tests/selectors/",
        "tests/locators/"
      ],
      "intermediatePrefixes": [
        "tests/flows/",
        "tests/page-objects/",
        "tests/selectors/",
        "tests/locators/"
      ],
      "specPrefixes": ["tests/smoke-appium/"],
      "catalogGroup": "e2e",
      "hop": 1,
      "tagsImportRegex": "import\\s*\\{([^}]+)\\}\\s*from\\s*['\"][^'\"]*\\/tags(?:\\.(?:js|ts))?['\"]",
      "onlyIfRemainingChangesMatch": {
        "prefixes": ["tests/"],
        "ignorablePathRegexes": [
          "^docs/",
          "\\.(md|mdx|txt)$",
          "\\.(svg|png)$",
          "^locales/languages/.*\\.json$",
          "^\\.github/workflows/performance-test-runner\\.yml$",
          "^\\.github/workflows/run-performance-.*\\.yml$"
        ]
      }
    },
    "result": {
      "risk_level": "medium",
      "confidence": 92,
      "performance_tests": {
        "selected_tags": [],
        "reasoning": "No performance impact from shared test infra changes"
      }
    },
    "continue": true
  },
  {
    "name": "test-spec-tag-extraction",
    "description": "Spec files in tests/smoke/ or tests/smoke-appium/ changed — extract their tags and run directly",
    "trigger": {
      "type": "extractTagsFromChangedSpecs",
      "specPrefixes": ["tests/smoke-appium/"],
      "catalogGroup": "e2e",
      "tagsImportRegex": "import\\s*\\{([^}]+)\\}\\s*from\\s*['\"][^'\"]*\\/tags(?:\\.(?:js|ts))?['\"]",
      "onlyIfRemainingChangesMatch": {
        "prefixes": ["tests/"],
        "ignorablePathRegexes": [
          "^docs/",
          "\\.(md|mdx|txt)$",
          "\\.(svg|png)$",
          "^locales/languages/.*\\.json$",
          "^\\.github/workflows/performance-test-runner\\.yml$",
          "^\\.github/workflows/run-performance-.*\\.yml$"
        ]
