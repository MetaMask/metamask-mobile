{
  "setup-worktree": [
    "if [ -f $ROOT_WORKTREE_PATH/.js.env ]; then cp $ROOT_WORKTREE_PATH/.js.env .js.env; fi",
    "if [ -f $ROOT_WORKTREE_PATH/.ios.env ]; then cp $ROOT_WORKTREE_PATH/.ios.env .ios.env; fi",
    "if [ -f $ROOT_WORKTREE_PATH/.android.env ]; then cp $ROOT_WORKTREE_PATH/.android.env .android.env; fi",
    "if [ -f $ROOT_WORKTREE_PATH/.e2e.env ]; then cp $ROOT_WORKTREE_PATH/.e2e.env .e2e.env; fi",
    "if [ -d $ROOT_WORKTREE_PATH/.cursor/plans ]; then cp -r $ROOT_WORKTREE_PATH/.cursor/plans .cursor/plans; fi"
  ]
}
