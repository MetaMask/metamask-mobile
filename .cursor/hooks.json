{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node_modules/.bin/tooling-insight-cursor-pre-tool",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "matcher": "UserPromptSubmit",
        "command": "node_modules/.bin/tooling-insight-cursor-prompt",
        "timeout": 2
      }
    ]
  }
}
