# Paste vendor keys here after copying this file to `.env`.
# These files are the only place the keys should live. Do not put them in the
# mobile app's `.js.env` — Metro would ship them inside the app bundle.

# Hydromancer JSON WebSocket (optional if QuickNode is configured).
HYDROMANCER_API_KEY=

# QuickNode Hyperliquid gRPC StreamL2Book (optional if Hydromancer is configured).
# Endpoint form: your-endpoint.hype-mainnet.quiknode.pro:10000
QUICKNODE_GRPC_ENDPOINT=
QUICKNODE_API_TOKEN=

# Port the relay listens on.
PORT=8787
