{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "ignorePatterns": [
    "scripts/inpage-bridge/**",
    "app/core/InpageBridgeWeb3.js",
    "app/components/UI/Charts/AdvancedChart/webview/chartLogic.js",
    "app/components/UI/Charts/AdvancedChart/webview/chartLogicString.ts",
    "app/components/UI/Charts/AdvancedChart/webview/syncChartLogic.js",
    "app/util/blockies.js",
    "**/__snapshots__/**",
    "**/android/**",
    "**/build/**",
    "**/coverage/**",
    "**/ios/**",
    "jest.preprocessor.js",
    "**/node_modules/**",
    ".*",
    "!.eslintrc.*",
    "*.mjs",
    "*.cjs",
    "app/util/test/testSetup.js",
    "tests/scripts/ai-e2e-tags-selector.ts",
    "app/**/*-method-action-types.ts",
    "app/util/termsOfUse/termsOfUseContent.ts",
    "app/declarations/**"
  ],
  "rules": {
    "typescript/no-array-delete": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-meaningless-void-operator": "error",
    "typescript/no-unnecessary-qualifier": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-enum-initializers": "error",
    "no-loss-of-precision": "error",
    "react/rules-of-hooks": "error",
    "typescript/explicit-function-return-type": "warn",
    "typescript/no-empty-object-type": "warn",
    "typescript/no-deprecated": "warn",
    "no-unused-vars": [
      "warn",
      {
        "vars": "all",
        "args": "all",
        "argsIgnorePattern": "[_]+",
        "caughtErrors": "all",
        "ignoreRestSiblings": true,
        "reportVarsOnlyUsedAsTypes": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "rules": {
        "typescript/await-thenable": "error",
        "typescript/consistent-type-exports": "error",
        "typescript/no-base-to-string": "error",
        "typescript/no-floating-promises": "error",
        "typescript/no-implied-eval": "error",
        "typescript/no-misused-promises": "error",
        "typescript/no-unnecessary-boolean-literal-compare": "error",
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/only-throw-error": "error",
        "typescript/prefer-includes": "error",
        "typescript/prefer-nullish-coalescing": "error",
        "typescript/prefer-optional-chain": "error",
        "typescript/prefer-promise-reject-errors": [
          "error",
          { "allowThrowingUnknown": true }
        ],
        "typescript/prefer-readonly": "error",
        "typescript/prefer-reduce-type-parameter": "error",
        "typescript/prefer-string-starts-ends-with": "error",
        "typescript/promise-function-async": "error",
        "typescript/restrict-plus-operands": "error",
        "typescript/restrict-template-expressions": [
          "error",
          { "allowBoolean": true, "allowNumber": true }
        ],
        "typescript/switch-exhaustiveness-check": [
          "error",
          { "considerDefaultExhaustiveForUnions": true }
        ],
        "typescript/unbound-method": "error"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}"],
      "rules": {
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": ["*.js", "*.jsx"],
      "rules": {
        "no-unused-vars": "off",
        "typescript/no-deprecated": "off"
      }
    }
  ]
}
