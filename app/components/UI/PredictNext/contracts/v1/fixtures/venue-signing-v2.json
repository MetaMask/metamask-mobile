    "id": "kalshi-demo-signing-v2",
    "authenticationProfileId": "kalshi-a2t-v1",
    "implementation": {
      "id": "device-p256-rfc9421-v1",
      "params": {
        "authority": "demo-api.kalshi.co",
        "label": "kalshi",
        "tag": "kalshi-device-request-v1",
        "lifetimeSec": 60,
        "tokenScheme": "Kalshi-A2T",
        "headers": {
          "requestId": "kalshi-device-request-id",
          "key": "kalshi-device-key",
          "salt": "kalshi-device-key-salt"
        },
        "maxSignatures": 4
      }
    },
    "operations": {
      "portfolio.balance": {
        "class": "read",
        "steps": {
          "default": [
            {
              "request": "balance"
            }
          ]
        }
      },
      "onboarding.status": {
        "class": "read",
        "steps": {
          "default": [
            {
              "request": "balance"
            },
            {
              "request": "enrollment_current"
            }
          ]
        }
      },
      "onboarding.start": {
        "class": "mutation",
        "steps": {
          "default": [
            {
              "request": "enrollment_intent"
            }
          ]
        }
      },
      "onboarding.link": {
        "class": "mutation",
        "steps": {
          "default": [
            {
              "request": "link"
            }
          ]
        }
      },
      "onboarding.verify": {
        "class": "mutation",
        "steps": {
          "default": [
            {
              "request": "link_verify"
            }
          ]
        }
      },
      "onboarding.activate": {
        "class": "mutation",
        "confirmation": "per-intent",
        "steps": {
          "default": [
            {
              "request": "wallet_register"
            }
          ]
        }
      }
    },
    "requests": {
      "balance": {
        "class": "read",
        "method": "GET",
        "path": "/trade-api/v2/portfolio/balance"
      },
      "enrollment_current": {
        "class": "read",
        "method": "GET",
        "path": "/trade-api/v2/isv/enrollment/intents/current"
      },
      "enrollment_intent": {
        "class": "mutation",
        "method": "POST",
        "path": "/trade-api/v2/isv/enrollment/intents",
        "body": "empty",
        "idempotencyKey": {
          "input": "idempotencyKey"
        }
      },
      "link": {
        "class": "mutation",
        "method": "POST",
        "path": "/trade-api/v2/isv/users/link",
        "body": {
          "json": [
            {
              "key": "email",
              "value": {
                "input": "email",
                "transform": "trim",
                "shape": {
                  "kind": "opaque",
                  "maxLength": 320
                }
              }
            }
          ],
          "maxBytes": 512
        },
        "idempotencyKey": {
          "input": "idempotencyKey"
        }
      },
      "link_verify": {
        "class": "mutation",
        "method": "POST",
        "path": "/trade-api/v2/isv/users/link/verify",
        "body": {
          "json": [
            {
              "key": "code",
              "value": {
                "input": "code",
                "shape": {
                  "kind": "opaque",
                  "maxLength": 32
                }
              }
            }
          ],
          "maxBytes": 128
        },
        "idempotencyKey": {
          "input": "idempotencyKey"
        }
      },
      "wallet_register": {
        "class": "mutation",
        "method": "POST",
        "path": "/trade-api/v2/isv/wallet/register",
        "body": {
          "json": [
            {
              "key": "wallet_address",
              "value": {
                "input": "walletAddress",
                "shape": {
                  "kind": "opaque",
                  "maxLength": 128
                }
              }
            },
            {
              "key": "network",
              "value": {
                "input": "network",
                "shape": {
                  "kind": "opaque",
                  "maxLength": 32
                }
              }
            }
          ],
          "maxBytes": 512
        },
        "idempotencyKey": {
          "input": "idempotencyKey"
        }
      }
    }
  },
