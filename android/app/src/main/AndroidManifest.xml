		<meta-data android:name="expo.modules.updates.CODE_SIGNING_METADATA" android:value="{&quot;keyid&quot;:&quot;production&quot;,&quot;alg&quot;:&quot;rsa-v1_5-sha256&quot;}" />
		<meta-data android:name="expo.modules.updates.ENABLED" android:value="true" />
	</application>
</manifest>
