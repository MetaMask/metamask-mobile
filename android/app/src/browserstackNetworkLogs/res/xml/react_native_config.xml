<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
	<!--
	  Overlay used by BrowserStack / e2e Release builds.
	  BrowserStack installs its mitmproxy CA as a user certificate; Android 7+
	  apps must explicitly trust user CAs to capture network logs.
	-->
	<domain-config cleartextTrafficPermitted="true">
		<domain includeSubdomains="true">sslip.io</domain>
		<domain includeSubdomains="false">localhost</domain>
		<domain includeSubdomains="false">10.0.2.2</domain>
		<domain includeSubdomains="false">10.0.3.2</domain>
	</domain-config>
	<base-config cleartextTrafficPermitted="${isDebug}">
		<trust-anchors>
			<certificates src="system" />
			<certificates src="user" />
		</trust-anchors>
	</base-config>
</network-security-config>
