# Kalshi demo environment
KALSHI_BASE_URL=https://external-api.demo.kalshi.co

# Admin api_key (issued by Kalshi at onboarding).
# api_key_id is sent in the KALSHI-ACCESS-KEY header.
# PEM is the RSA private key, used to sign /trade-api/v2/isv/users/* admin calls.
KALSHI_ADMIN_API_KEY_ID=

# Either provide a path to the PEM file...
KALSHI_ADMIN_PEM_PATH=./admin.pem
# ...or inline the PEM contents (use \n for newlines).
# KALSHI_ADMIN_PEM=

# Backend listening port (mobile points here).
PORT=8080

# When true, log every Kalshi HTTP call (method, path, status) to stdout.
KALSHI_DEBUG=true
